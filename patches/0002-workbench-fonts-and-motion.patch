+++ b/src/vs/workbench/browser/media/cinder.css
@@ -0,0 +1,55 @@
+/*---------------------------------------------------------------------------------------------
+ *  Cinder: workbench typography and motion.
+ *  Fonts: Inter and JetBrains Mono, SIL Open Font License 1.1.
+ *--------------------------------------------------------------------------------------------*/
+
+@font-face {
+	font-family: 'Inter';
+	font-style: normal;
+	font-weight: 100 900;
+	font-display: swap;
+	src: url('./Inter.ttf') format('truetype');
+}
+
+@font-face {
+	font-family: 'JetBrains Mono';
+	font-style: normal;
+	font-weight: 100 800;
+	font-display: swap;
+	src: url('./JetBrainsMono.ttf') format('truetype');
+}
+
+.monaco-workbench.mac { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
+.monaco-workbench.windows { font-family: 'Inter', "Segoe WPC", "Segoe UI", sans-serif; }
+.monaco-workbench.linux { font-family: 'Inter', system-ui, "Ubuntu", "Droid Sans", sans-serif; }
+
+.monaco-workbench {
+	font-feature-settings: 'cv11';
+}
+
+/* Softer, quicker feedback on the things you touch most. */
+.monaco-workbench .monaco-list-row,
+.monaco-workbench .tabs-container > .tab,
+.monaco-workbench .action-item > .action-label,
+.monaco-workbench .monaco-button {
+	transition: background-color 110ms ease, color 110ms ease, opacity 110ms ease;
+}
+
+.monaco-workbench .quick-input-widget {
+	animation: cinder-rise 140ms cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+.monaco-workbench .notifications-toasts .notification-toast-container {
+	animation: cinder-rise 180ms cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+@keyframes cinder-rise {
+	from { opacity: 0; transform: translateY(-4px); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+	.monaco-workbench .quick-input-widget,
+	.monaco-workbench .notifications-toasts .notification-toast-container {
+		animation: none;
+	}
+}
