{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["node", "vscode"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts"]
}
