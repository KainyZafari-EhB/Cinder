	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#5f6a7d",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#ffad42"
			}
		},
		{
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#a6d98c"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#e3a1d6"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"variable.function"
			],
			"settings": {
				"foreground": "#8fc4ff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"storage.type.java",
				"storage.type.cs"
			],
			"settings": {
				"foreground": "#79d6d0"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable"
			],
			"settings": {
				"foreground": "#e3e7ee"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c6cdd8"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#8d97a8"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#ff9a62"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#a6d98c"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.other.character-class.regexp"
			],
			"settings": {
				"foreground": "#79d6d0"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#e3e7ee",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#ffad42",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#e3e7ee",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#e3e7ee",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block"
			],
			"settings": {
				"foreground": "#a6d98c"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#8fc4ff"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ff9a62"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": {
			"foreground": "#e3e7ee",
			"italic": true
		},
		"property": "#c6cdd8",
		"type": "#79d6d0",
		"class": "#79d6d0",
		"interface": "#79d6d0",
		"enumMember": "#e3a1d6",
		"function": "#8fc4ff",
		"method": "#8fc4ff"
	}
}
