	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8b837b",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#c9480a"
			}
		},
		{
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#8a5a12"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#7d4fb0"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"variable.function"
			],
			"settings": {
				"foreground": "#0f6b8f"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"storage.type.java",
				"storage.type.cs"
			],
			"settings": {
				"foreground": "#18786b"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable"
			],
			"settings": {
				"foreground": "#1d1a17"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#4a433d"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#6e665f"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#b8420c"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#8a5a12"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.other.character-class.regexp"
			],
			"settings": {
				"foreground": "#18786b"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#1d1a17",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#c9480a",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#1d1a17",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#1d1a17",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block"
			],
			"settings": {
				"foreground": "#8a5a12"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#0f6b8f"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#b8420c"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": {
			"foreground": "#1d1a17",
			"italic": true
		},
		"property": "#4a433d",
		"type": "#18786b",
		"class": "#18786b",
		"interface": "#18786b",
		"enumMember": "#7d4fb0",
		"function": "#0f6b8f",
		"method": "#0f6b8f"
	}
}
